{
  "expo": {
    "name": "MedTrack",
    "slug": "medtrack",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "medtrack",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#101619",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.medtrack.client",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "app.medtrack.client",
      "adaptiveIcon": {
        "backgroundColor": "#0891a8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0891a8",
          "defaultChannel": "reminders"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "http://localhost:5000/api"
    }
  }
}
