{
  "expo": {
    "name": "MedTrack",
    "slug": "medtrack",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "medtrack",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#101619",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.medtrack.client",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "app.medtrack.client",
      "adaptiveIcon": {
        "backgroundColor": "#0891a8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0891a8",
          "defaultChannel": "reminders"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "MedTrack uses the camera to take a photo of your medicine strip, so you can recognise it later. The photo stays on your phone.",
          "photosPermission": "MedTrack lets you choose a photo of your medicine strip. The photo stays on your phone.",
          "microphonePermission": false
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "apiUrl": "http://localhost:5000/api",
      "eas": {
        "projectId": "583627ed-cf3f-4b1b-bae5-f42e26b39cc9"
      }
    }
  }
}
