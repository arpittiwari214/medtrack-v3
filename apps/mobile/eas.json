{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "MEDTRACK_API_URL": "https://medtrack-api.fly.dev/api" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "MEDTRACK_API_URL": "https://medtrack-api.fly.dev/api" }
    }
  },
  "submit": {
    "production": {}
  }
}
