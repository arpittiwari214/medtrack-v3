{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "MEDTRACK_API_URL": "https://medtrack-backend-jtg7.onrender.com/api" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "MEDTRACK_API_URL": "https://medtrack-backend-jtg7.onrender.com/api" }
    }
  },
  "submit": {
    "production": {}
  }
}
