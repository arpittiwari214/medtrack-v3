{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "MEDTRACK_API_URL": "https://medtrack-backend-jtg7.onrender.com/api"
      },
      "autoIncrement": true
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "MEDTRACK_API_URL": "https://medtrack-backend-jtg7.onrender.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
