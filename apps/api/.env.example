# ─────────────────────────────────────────────────────────────
# MedTrack API — copy to .env and fill in.
# .env is gitignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/medtrack
# Atlas:  mongodb+srv://USER:PASSWORD@cluster.mongodb.net/medtrack
# On Atlas, allow your host's IP (or 0.0.0.0/0 for a platform with
# dynamic egress IPs) under Network Access, or connections hang.
MONGODB_URI=mongodb://localhost:27017/medtrack

# ── Tokens ───────────────────────────────────────────────────
# Two DIFFERENT secrets, 32+ chars each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# A leaked access secret must not be usable to mint refresh tokens.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_32_chars_min
JWT_REFRESH_SECRET=replace_me_with_a_DIFFERENT_long_random_string

# Access tokens are short-lived; the refresh token carries the session.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated exact origins. Wildcards are rejected in production.
# The mobile app sends no Origin header and does not need listing here.
CORS_ORIGINS=http://localhost:5173

# ── Public URLs (used to build links in emails) ───────────────
WEB_APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# ── Email (optional) ─────────────────────────────────────────
# Leave blank to run without email: alerts are still recorded in-app,
# and the caregiver dashboard stays correct.
# For Gmail, SMTP_PASSWORD must be an App Password, not your login.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=MedTrack
EMAIL_FROM_ADDRESS=

# ── Push notifications (optional) ────────────────────────────
# Only needed if your Expo project uses restricted push tokens.
EXPO_ACCESS_TOKEN=

# ── Behaviour ────────────────────────────────────────────────
# Minutes after a dose is due before it counts as missed,
# unless a medicine overrides it.
DEFAULT_MISSED_GRACE_MINUTES=60

# Set false on any additional instance so background jobs run in
# exactly one place.
SCHEDULER_ENABLED=true

# Proxy hops in front of the app. Railway and Fly both put exactly one.
# Do NOT raise this without reason: trusting extra hops lets a client
# spoof X-Forwarded-For and defeat every per-IP rate limit.
TRUST_PROXY_HOPS=1
